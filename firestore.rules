service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is the therapist (João)
    function isTherapist() {
      return request.auth != null && request.auth.token.email == 'jean.desfontaines@gmail.com';
    }

    // Appointments rules
    match /appointments/{appointmentId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isTherapist() || (request.auth != null && resource.data.clientId == request.auth.uid);
    }

    // Clients rules
    match /clients/{clientId} {
      allow create, update: if request.auth != null && request.auth.uid == clientId;
      allow read: if isTherapist() || (request.auth != null && request.auth.uid == clientId);
    }

    // Availability rules (for the therapist dashboard)
    match /availability/{slotId} {
      allow read: if true; // Everyone can see available slots
      allow write: if isTherapist();
    }
    
    // Settings rules
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isTherapist();
    }
  }
}
