rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is the therapist (João)
    function isTherapist() {
      return request.auth != null && (
        request.auth.token.email == 'jean.desfontaines@gmail.com' || 
        request.auth.uid == 'udOfNm9dSFOGgSc0FrJwH7zqqFc2' ||
        request.auth.uid == 'v26ewfAECzY3jbXvayvUjuAhzrf1'
      );
    }

    // Appointments rules
    match /appointments/{appointmentId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isTherapist() || (request.auth != null && resource.data.clientId == request.auth.uid);
    }

    // Clients rules
    match /clients/{clientId} {
      allow read, write: if isTherapist();
      allow create, update, read: if request.auth != null && request.auth.uid == clientId;
    }

    // Configuration rules (for slots and other settings)
    match /config/{configId} {
      allow read: if true;
      allow write: if isTherapist();
    }

    // Availability rules (for the therapist dashboard & public booking locks)
    match /availability/{slotId} {
      allow read: if true; // Everyone can see available slots
      allow write: if isTherapist() || (request.auth != null && request.resource.data.type == 'booked');
    }
    
    // Settings rules
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isTherapist();
    }

    // Invoices rules
    match /invoices/{invoiceId} {
      allow read, write: if isTherapist();
    }
  }
}
